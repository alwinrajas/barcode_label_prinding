<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         Design tokens (blueprint §12). Colour carries meaning, not
         decoration; semantic Status.* aliases keep status colour identical
         in every grid, badge and tile. Status is NEVER colour-only.
         ================================================================ -->

    <Color x:Key="Color.Surface.Base">#F6F7F9</Color>
    <Color x:Key="Color.Surface.Card">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Sunken">#EDEFF3</Color>
    <Color x:Key="Color.Border.Default">#DFE3E8</Color>
    <Color x:Key="Color.Text.Primary">#12161C</Color>
    <Color x:Key="Color.Text.Secondary">#5A6572</Color>
    <Color x:Key="Color.Brand.Primary">#1F4E79</Color>
    <Color x:Key="Color.Brand.PrimaryHover">#2A6099</Color>
    <Color x:Key="Color.Accent.Success">#1F8A4C</Color>
    <Color x:Key="Color.Accent.Warning">#B26B00</Color>
    <Color x:Key="Color.Accent.Danger">#C0392B</Color>
    <Color x:Key="Color.Accent.Info">#2A6FB5</Color>

    <SolidColorBrush x:Key="Surface.Base" Color="{StaticResource Color.Surface.Base}" />
    <SolidColorBrush x:Key="Surface.Card" Color="{StaticResource Color.Surface.Card}" />
    <SolidColorBrush x:Key="Surface.Sunken" Color="{StaticResource Color.Surface.Sunken}" />
    <SolidColorBrush x:Key="Border.Default" Color="{StaticResource Color.Border.Default}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brand.Primary" Color="{StaticResource Color.Brand.Primary}" />
    <SolidColorBrush x:Key="Brand.PrimaryHover" Color="{StaticResource Color.Brand.PrimaryHover}" />
    <SolidColorBrush x:Key="Accent.Success" Color="{StaticResource Color.Accent.Success}" />
    <SolidColorBrush x:Key="Accent.Warning" Color="{StaticResource Color.Accent.Warning}" />
    <SolidColorBrush x:Key="Accent.Danger" Color="{StaticResource Color.Accent.Danger}" />
    <SolidColorBrush x:Key="Accent.Info" Color="{StaticResource Color.Accent.Info}" />

    <!-- Semantic status aliases -->
    <SolidColorBrush x:Key="Status.Queued" Color="{StaticResource Color.Accent.Warning}" />
    <SolidColorBrush x:Key="Status.Printing" Color="{StaticResource Color.Accent.Info}" />
    <SolidColorBrush x:Key="Status.Completed" Color="{StaticResource Color.Accent.Success}" />
    <SolidColorBrush x:Key="Status.Failed" Color="{StaticResource Color.Accent.Danger}" />

    <!-- Sidebar (dark navy panel derived from Brand.Primary) -->
    <Color x:Key="Color.Sidebar.Background">#17304A</Color>
    <Color x:Key="Color.Sidebar.Hover">#22405F</Color>
    <Color x:Key="Color.Sidebar.Active">#2A6099</Color>
    <SolidColorBrush x:Key="Sidebar.Background" Color="{StaticResource Color.Sidebar.Background}" />
    <SolidColorBrush x:Key="Sidebar.Hover" Color="{StaticResource Color.Sidebar.Hover}" />
    <SolidColorBrush x:Key="Sidebar.Active" Color="{StaticResource Color.Sidebar.Active}" />
    <SolidColorBrush x:Key="Sidebar.Text" Color="#D7E1EC" />
    <SolidColorBrush x:Key="Sidebar.TextMuted" Color="#8FA3B8" />

</ResourceDictionary>
