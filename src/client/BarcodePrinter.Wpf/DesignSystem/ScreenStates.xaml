<!--
    The five UI states every screen must implement (§12): loading, empty, error,
    partial, ready.

    Defined once here rather than hand-written per screen, so "the server is
    unreachable" looks and reads the same everywhere. A screen that invents its
    own error treatment is how one screen ends up showing stale data silently
    while its neighbour shows a red banner.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- LOADING: a 2 px indeterminate bar pinned to the top of the content area.
         Deliberately not a spinner over the grid: refreshing data must not hide
         the figures the operator is still reading. -->
    <Style x:Key="State.BusyBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="2" />
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Foreground" Value="{StaticResource Brand.Primary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ERROR / PARTIAL: one banner, two severities. Shown ABOVE the content and
         never instead of it — when a refresh fails, the previously loaded data
         is still the best information available, and hiding it helps nobody.
         The banner is what stops it being read as current. -->
    <Style x:Key="State.Banner" TargetType="Border">
        <Setter Property="Background" Value="#FDF2F0" />   <!-- 5% Accent.Danger -->
        <Setter Property="BorderBrush" Value="{StaticResource Accent.Danger}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="State.BannerText" TargetType="TextBlock"
           BasedOn="{StaticResource Text.Body}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource Text.Primary}" />
    </Style>

    <!-- EMPTY: an explanation and, where there is one, the action that fixes it.
         Never a blank panel — a blank panel is indistinguishable from a screen
         that failed to load. -->
    <Style x:Key="State.EmptyTitle" TargetType="TextBlock"
           BasedOn="{StaticResource Text.Body}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
        <Setter Property="Margin" Value="0,32,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
