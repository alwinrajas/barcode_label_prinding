<!--
    Layout + metric tokens (Phase 2). Merged FIRST so every other dictionary
    can reference them. Numbers live here so "how far apart are things" is a
    decision made once, not re-estimated per screen.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Spacing scale -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.SM">8</sys:Double>
    <sys:Double x:Key="Space.MD">12</sys:Double>
    <sys:Double x:Key="Space.LG">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <sys:Double x:Key="Space.XXL">32</sys:Double>

    <Thickness x:Key="Pad.Card">16</Thickness>
    <Thickness x:Key="Pad.Page">24</Thickness>
    <Thickness x:Key="Pad.Input">10,0</Thickness>
    <Thickness x:Key="Gap.Below.SM">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Below.MD">0,0,0,12</Thickness>
    <Thickness x:Key="Gap.Below.LG">0,0,0,16</Thickness>

    <!-- Control metrics -->
    <sys:Double x:Key="Control.Height">32</sys:Double>
    <sys:Double x:Key="Control.HeightLG">40</sys:Double>
    <sys:Double x:Key="Radius.Control">6</sys:Double>
    <sys:Double x:Key="Radius.Card">8</sys:Double>
    <CornerRadius x:Key="Corner.Control">6</CornerRadius>
    <CornerRadius x:Key="Corner.Card">8</CornerRadius>
    <CornerRadius x:Key="Corner.Pill">10</CornerRadius>

    <!-- Semantic soft backgrounds (~10% tints) for pills, banners, hovers.
         Same hue family as the Accent.* brushes in Colors.xaml. -->
    <Color x:Key="Color.Success.Soft">#E8F3EC</Color>
    <Color x:Key="Color.Warning.Soft">#FDF3E3</Color>
    <Color x:Key="Color.Danger.Soft">#F9E9E7</Color>
    <Color x:Key="Color.Info.Soft">#E8F0F9</Color>
    <SolidColorBrush x:Key="Brush.Success.Soft" Color="{StaticResource Color.Success.Soft}" />
    <SolidColorBrush x:Key="Brush.Warning.Soft" Color="{StaticResource Color.Warning.Soft}" />
    <SolidColorBrush x:Key="Brush.Danger.Soft" Color="{StaticResource Color.Danger.Soft}" />
    <SolidColorBrush x:Key="Brush.Info.Soft" Color="{StaticResource Color.Info.Soft}" />

    <!-- Interaction surfaces shared by rows, list items and ghost buttons -->
    <SolidColorBrush x:Key="Surface.Hover" Color="#F3F6FA" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#E8F0F9" />
    <SolidColorBrush x:Key="Accent.Danger.Hover" Color="#A93226" />
    <SolidColorBrush x:Key="Border.Hover" Color="#C6CDD5" />
    <SolidColorBrush x:Key="Scroll.Thumb" Color="#C4CBD4" />
    <SolidColorBrush x:Key="Scroll.Thumb.Hover" Color="#A9B2BD" />
    <SolidColorBrush x:Key="Scroll.Thumb.Drag" Color="#8F9AA7" />

</ResourceDictionary>
