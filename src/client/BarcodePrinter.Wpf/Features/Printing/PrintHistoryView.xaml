<UserControl x:Class="BarcodePrinter.Wpf.Features.Printing.PrintHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.H1}" Text="Print History"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Height="36" Padding="14,0" Content="Cancel job"
                    Command="{Binding CancelJobCommand}"
                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Height="36" Padding="14,0"
                    Style="{StaticResource Button.Primary}" Content="↻  Reprint"
                    Command="{Binding ReprintCommand}"
                    Visibility="{Binding CanReprint, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Period" Margin="0,0,0,4" />
                    <ComboBox Width="140" Height="36" ItemsSource="{Binding RangePresets}"
                              SelectedItem="{Binding SelectedRange}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Status" Margin="0,0,0,4" />
                    <ComboBox Width="150" Height="36" ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding SelectedStatus}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Search" Margin="0,0,0,4" />
                    <TextBox Width="240" Style="{StaticResource Input.Text}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search print history" />
                </StackPanel>
                <CheckBox VerticalAlignment="Bottom" Margin="0,0,16,8" Content="Reprints only"
                          IsChecked="{Binding ReprintsOnly}"
                          FontFamily="{StaticResource Font.Ui}" FontSize="14" />
                <Button VerticalAlignment="Bottom" Margin="0,0,0,4" Height="36" Padding="14,0"
                        Content="Refresh" Command="{Binding SearchCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                          RowHeight="40" SelectionMode="Single" EnableRowVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job" Binding="{Binding JobNo}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="When"
                                            Binding="{Binding RequestedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="140" />
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductCode}" Width="150" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="110" />
                        <DataGridTextColumn Header="Cartons" Width="110">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0}–{1}">
                                    <Binding Path="CartonFrom" />
                                    <Binding Path="CartonTo" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Labels" Binding="{Binding LabelCount}" Width="80" />
                        <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="140" />
                        <DataGridTextColumn Header="User" Binding="{Binding RequestedBy}" Width="110" />
                        <DataGridTemplateColumn Header="Status" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="9" Padding="8,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Status.Queued}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Background" Value="{StaticResource Status.Completed}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Background" Value="{StaticResource Status.Failed}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Printing">
                                                            <Setter Property="Background" Value="{StaticResource Status.Printing}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                            <Setter Property="Background" Value="{StaticResource Text.Secondary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" Foreground="White"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="↻" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   FontWeight="Bold" ToolTip="Reprint"
                                                   Foreground="{StaticResource Accent.Info}"
                                                   Visibility="{Binding IsReprint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface.Sunken}" Padding="14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="WHAT WAS PRINTED" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                                        <Run Text="{Binding ProductCode, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="{Binding Description, Mode=OneWay}" />
                                        <Run Text="{Binding Batch, Mode=OneWay, StringFormat=· Batch {0}}" />
                                        <Run Text="{Binding QuantityText, Mode=OneWay, StringFormat=· Qty {0}}" />
                                        <Run Text="{Binding ProductionDate, Mode=OneWay, StringFormat=· Prod {0:dd/MM/yyyy}}" />
                                        <Run Text="{Binding ExpiryDate, Mode=OneWay, StringFormat=· Exp {0:dd/MM/yyyy}}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0">
                                        <Run Text="{Binding TemplateCode, Mode=OneWay, StringFormat=Template {0}}" />
                                        <Run Text="{Binding TemplateVersion, Mode=OneWay, StringFormat=v{0}}" />
                                        <Run Text="{Binding CopiesPerLabel, Mode=OneWay, StringFormat=· {0} copies each}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                               Foreground="{StaticResource Accent.Info}"
                                               Visibility="{Binding ReprintReason, Converter={StaticResource NullToCollapsed}}"
                                               Text="{Binding ReprintReason, StringFormat=Reprint reason: {0}}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                               Foreground="{StaticResource Accent.Danger}" TextWrapping="Wrap"
                                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}"
                                               Text="{Binding ErrorMessage}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource Brand.Primary}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Accent.Danger}"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <Button HorizontalAlignment="Center" Style="{StaticResource Button.Primary}" Content="Load more"
                    Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
