<UserControl x:Class="BarcodePrinter.Wpf.Features.Printing.PrintHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BarcodePrinter.Wpf.Controls"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Print History"
                             Description="Every print job, live status, and reprint.">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Secondary}" Height="36" Content="Refresh"
                            Command="{Binding SearchCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Content="Reprint"
                            Command="{Binding ReprintCommand}"
                            Visibility="{Binding CanReprint, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Danger}" Margin="8,0,0,0" Height="36"
                            Content="Cancel job" Command="{Binding CancelJobCommand}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}"
                Margin="{StaticResource Gap.Below.MD}">
            <WrapPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="From" Margin="0,0,0,4" />
                    <DatePicker Width="140" Height="36" SelectedDate="{Binding FromDate}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="To" Margin="0,0,0,4" />
                    <DatePicker Width="140" Height="36" SelectedDate="{Binding ToDate}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Status" Margin="0,0,0,4" />
                    <ComboBox Width="150" ItemsSource="{Binding Statuses}"
                              SelectedItem="{Binding SelectedStatus}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Search" Margin="0,0,0,4" />
                    <TextBox Width="260" Style="{StaticResource Input.Search}"
                             Tag="Job no, product code or batch…"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search print history" />
                </StackPanel>
                <CheckBox VerticalAlignment="Bottom" Margin="0,0,0,14" Content="Reprints only"
                          IsChecked="{Binding ReprintsOnly}" />
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job" Binding="{Binding JobNo}" Width="170">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="When"
                                            Binding="{Binding RequestedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                        <DataGridTextColumn Header="Product code" Binding="{Binding ProductCode}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="100" />
                        <DataGridTextColumn Header="Cartons" Width="100">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0}–{1}">
                                    <Binding Path="CartonFrom" />
                                    <Binding Path="CartonTo" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Labels" Binding="{Binding LabelCount}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="130" />
                        <DataGridTextColumn Header="User" Binding="{Binding RequestedBy}" Width="100" />
                        <DataGridTemplateColumn Header="Status" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:StatusPill Status="{Binding Status}" />
                                        <TextBlock Text="↻" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   FontWeight="Bold" ToolTip="Reprint"
                                                   Foreground="{StaticResource Accent.Info}"
                                                   Visibility="{Binding IsReprint, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface.Sunken}" Padding="{StaticResource Pad.Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="WHAT WAS PRINTED" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                                        <Run Text="{Binding ProductCode, Mode=OneWay}" FontWeight="SemiBold"
                                             FontFamily="{StaticResource Font.Mono}" />
                                        <Run Text="{Binding Description, Mode=OneWay}" />
                                        <Run Text="{Binding Batch, Mode=OneWay, StringFormat=· Batch {0}}" />
                                        <Run Text="{Binding QuantityText, Mode=OneWay, StringFormat=· Qty {0}}" />
                                        <Run Text="{Binding ProductionDate, Mode=OneWay, StringFormat=· Prod {0:dd/MM/yyyy}}" />
                                        <Run Text="{Binding ExpiryDate, Mode=OneWay, StringFormat=· Exp {0:dd/MM/yyyy}}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0">
                                        <Run Text="{Binding TemplateCode, Mode=OneWay, StringFormat=Template {0}}" />
                                        <Run Text="{Binding TemplateVersion, Mode=OneWay, StringFormat=v{0}}" />
                                        <Run Text="{Binding CopiesPerLabel, Mode=OneWay, StringFormat=· {0} copies each}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0">
                                        <Run Text="{Binding DispatchedAtUtc, Mode=OneWay, StringFormat=Dispatched {0:dd/MM/yyyy HH:mm:ss}}" />
                                        <Run Text="{Binding ConfirmedAtUtc, Mode=OneWay, StringFormat=· Confirmed {0:dd/MM/yyyy HH:mm:ss}}" />
                                        <Run Text="{Binding LabelsConfirmed, Mode=OneWay, StringFormat=· {0} labels confirmed}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                               Foreground="{StaticResource Accent.Info}"
                                               Visibility="{Binding ReprintReason, Converter={StaticResource NullToCollapsed}}"
                                               Text="{Binding ReprintReason, StringFormat=Reprint reason: {0}}" />
                                    <Border Background="{StaticResource Brush.Danger.Soft}" CornerRadius="6"
                                            Padding="10,8" Margin="0,8,0,0"
                                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource Accent.Danger}"
                                                       Text="{Binding ErrorCode}"
                                                       Visibility="{Binding ErrorCode, Converter={StaticResource NullToCollapsed}}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                                       Foreground="{StaticResource Accent.Danger}" TextWrapping="Wrap"
                                                       Text="{Binding ErrorMessage}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <controls:EmptyState Glyph="&#xE81C;" Title="No print jobs"
                                     Message="No jobs match these filters. Widen the date range, clear the search, or choose another status."
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <controls:ErrorState Message="{Binding ErrorMessage}" Reference="{Binding ErrorReference}"
                                     RetryCommand="{Binding SearchCommand}"
                                     Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
                <ProgressBar Style="{StaticResource State.BusyBar}" />
            </Grid>
        </Border>

        <controls:LoadMoreFooter Grid.Row="3" HasMore="{Binding HasMore}" IsLoading="{Binding IsBusy}"
                                 Command="{Binding LoadMoreCommand}" CountText="{Binding CountText}" />
    </Grid>
</UserControl>
