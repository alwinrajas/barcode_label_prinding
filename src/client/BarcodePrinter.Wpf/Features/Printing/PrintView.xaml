<UserControl x:Class="BarcodePrinter.Wpf.Features.Printing.PrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface.Base}">
    <UserControl.InputBindings>
        <!-- §12.4: an experienced operator never touches the mouse. -->
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding PrintCommand}" />
    </UserControl.InputBindings>
    <!-- One screen, four numbered sections (§12.4): a wizard would add clicks
         to the most-repeated task in the application. -->
    <Grid Margin="24">
        <!-- The form is fixed-width and the preview takes the rest. The label is
             the thing the operator is checking before committing media and
             carton numbers, so on a wide screen the extra pixels belong to it,
             not to text boxes that were already wide enough. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480" MinWidth="420" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.H1}" Text="Print Labels" Margin="0,0,0,16" />

                <!-- ═══ 1. PRODUCT ═══ -->
                <Border Style="{StaticResource Card}" Padding="18">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="1 · PRODUCT" Margin="0,0,0,8" />
                        <TextBox x:Name="SearchBox" Style="{StaticResource Input.Text}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search products" />
                        <ListBox MaxHeight="150" Margin="0,8,0,0" BorderThickness="1"
                                 BorderBrush="{StaticResource Border.Default}"
                                 ItemsSource="{Binding SearchResults}"
                                 SelectedItem="{Binding SelectedProduct}"
                                 Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="{Binding Code}" FontFamily="{StaticResource Font.Mono}"
                                                   FontWeight="SemiBold" Width="150" />
                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource Text.Secondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Margin="0,10,0,0" Padding="12" CornerRadius="6"
                                Background="{StaticResource Surface.Sunken}"
                                Visibility="{Binding ProductDetail, Converter={StaticResource NullToCollapsed}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold">
                                    <Run Text="✔ " Foreground="{StaticResource Accent.Success}" />
                                    <Run Text="{Binding ProductDetail.Code, Mode=OneWay}"
                                         FontFamily="{StaticResource Font.Mono}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding ProductDetail.Description, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                                    <Run Text="{Binding ProductDetail.Uom, Mode=OneWay, StringFormat=UOM {0}}" />
                                    <Run Text="{Binding ProductDetail.Size, Mode=OneWay, StringFormat=· Size {0}}" />
                                    <Run Text="{Binding ProductDetail.Color, Mode=OneWay, StringFormat=· {0}}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══ 2. THIS PRINT RUN ═══ -->
                <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="2 · THIS PRINT RUN" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Batch" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input.Text}"
                                         Text="{Binding Batch, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Quantity" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input.Text}"
                                         Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Production date" Margin="0,0,0,4" />
                                <DatePicker Height="36" SelectedDate="{Binding ProductionDate}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Expiry date" Margin="0,0,0,4" />
                                <DatePicker Height="36" SelectedDate="{Binding ExpiryDate}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Accent.Info}"
                                   Text="{Binding OverrideNotice}"
                                   Visibility="{Binding OverrideNotice, Converter={StaticResource NullToCollapsed}}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Carton start *" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                         Text="{Binding CartonFrom, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Carton end *" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                         Text="{Binding CartonTo, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Copies each" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                         Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                            </StackPanel>
                        </Grid>

                        <!-- Stated in words BEFORE the button, and again on it -->
                        <Border Margin="0,12,0,0" Padding="10,6" CornerRadius="6"
                                Background="{StaticResource Surface.Sunken}">
                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                       Text="{Binding RunSummary}" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══ 3. PREVIEW · 4. PRINT ═══ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Label}" Text="3 · PREVIEW" />
                        <ProgressBar DockPanel.Dock="Right" Width="60" Height="3" IsIndeterminate="True"
                                     BorderThickness="0" Background="Transparent"
                                     Foreground="{StaticResource Brand.Primary}"
                                     Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVisibility}}" />
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource Surface.Sunken}" CornerRadius="6" Padding="12">
                        <Grid>
                            <!-- The rendered label preview. Fills available preview panel space. -->
                            <Border Background="White" CornerRadius="4" Padding="8"
                                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                    Visibility="{Binding PreviewImage, Converter={StaticResource NullToCollapsed}}">
                                <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="Label preview" />
                            </Border>

                            <!-- Said plainly when the label cannot be drawn -->
                            <TextBlock Style="{StaticResource Text.Caption}" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       MaxWidth="280" TextWrapping="Wrap" Margin="12"
                                       Text="{Binding PreviewUnavailable}"
                                       Visibility="{Binding PreviewUnavailable, Converter={StaticResource NullToCollapsed}}" />

                            <TextBlock Text="Choose a product and template to see the label."
                                       Style="{StaticResource Text.Caption}" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding PreviewZpl, Converter={StaticResource NullToVisible}}" />
                        </Grid>
                    </Border>

                    <!-- The exact bytes, for support and template sign-off -->
                    <Expander Grid.Row="2" Margin="0,8,0,0" Padding="0,4,0,0"
                              Header="Label data sent to the printer"
                              Visibility="{Binding PreviewZpl, Converter={StaticResource NullToCollapsed}}">
                        <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" Padding="8">
                            <TextBlock Text="{Binding PreviewZpl}" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="10" Foreground="{StaticResource Text.Secondary}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Expander>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Label}" Text="4 · PRINT" Margin="0,0,0,8" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Template" Margin="0,0,0,4" />
                    <ComboBox Height="36" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                              DisplayMemberPath="Name" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Printer" Margin="0,12,0,4" />
                    <ComboBox Height="36" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                              DisplayMemberPath="Name" />

                    <Button Margin="0,16,0,0" Height="48" Style="{StaticResource Button.Primary}"
                            FontSize="16"
                            Command="{Binding PrintCommand}"
                            IsEnabled="{Binding IsPrinting, Converter={StaticResource InverseBool}}">
                        <TextBlock>
                            <Run Text="🖨  PRINT — " />
                            <Run Text="{Binding RunSummary, Mode=OneWay}" />
                        </TextBlock>
                    </Button>

                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                            Background="{StaticResource Surface.Sunken}"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Foreground="{StaticResource Accent.Danger}" TextWrapping="Wrap"
                                   Text="{Binding ErrorMessage}" />
                    </Border>

                    <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                            Background="{StaticResource Surface.Sunken}"
                            Visibility="{Binding SuccessMessage, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                   Foreground="{StaticResource Accent.Success}" TextWrapping="Wrap"
                                   Text="{Binding SuccessMessage}" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
