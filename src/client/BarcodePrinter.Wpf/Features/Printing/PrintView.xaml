<UserControl x:Class="BarcodePrinter.Wpf.Features.Printing.PrintView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BarcodePrinter.Wpf.Controls"
             xmlns:printing="clr-namespace:BarcodePrinter.Wpf.Features.Printing"
             Background="{StaticResource Surface.Base}"
             PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <printing:UtcToLocalTimeConverter x:Key="UtcToLocalTime" />
    </UserControl.Resources>
    <UserControl.InputBindings>
        <!-- §12.4: an experienced operator never touches the mouse. Enter never
             prints (no IsDefault button on this screen); Ctrl+P is the explicit
             keyboard route. -->
        <KeyBinding Modifiers="Control" Key="P" Command="{Binding PrintCommand}" />
    </UserControl.InputBindings>

    <DockPanel Margin="{StaticResource Pad.Page}">
        <controls:PageHeader DockPanel.Dock="Top"
                             Title="Print Labels"
                             Description="Create and print production labels." />

        <!-- Initialization honesty: if printers could not be loaded (or none
             are active) the screen says so and offers Retry, instead of a
             permanently dead Print button. -->
        <controls:ErrorState DockPanel.Dock="Top" Margin="0,0,0,16"
                             Message="{Binding InitErrorMessage}"
                             RetryCommand="{Binding InitializeCommand}"
                             Visibility="{Binding HasInitError, Converter={StaticResource BoolToVisibility}}" />

        <!-- There is deliberately NO page-level scroller around both columns.
             Side by side, the ContentGrid is exactly one page tall, ONLY the
             form scrolls (FormScroller) and the preview — which lives outside
             that scroller — is pinned: an operator checks the label against the
             values they are typing, so it must not scroll off the screen.
             Stacked (content narrower than ~1000px) the code-behind moves the
             preview INTO the scroller, below the form, and that single scroller
             becomes the page scroller. See OnContentSizeChanged. -->
        <Grid x:Name="ContentGrid" SizeChanged="OnContentSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FormColumn" Width="5*" MaxWidth="520" MinWidth="320" />
                <ColumnDefinition x:Name="GutterColumn" Width="16" />
                <ColumnDefinition x:Name="PreviewColumn" Width="7*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Form column: its own scroller, always Auto ═══ -->
            <ScrollViewer x:Name="FormScroller" Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0">
                <!-- Row 0 is the form; row 1 is the slot the preview is re-homed
                     into when the layout collapses to a single column. -->
                <Grid x:Name="ScrollHost">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <StackPanel x:Name="FormHost" Grid.Row="0" VerticalAlignment="Top">

                    <!-- Product -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.H2}" Text="Product" Margin="0,0,0,12" />
                            <TextBox x:Name="SearchBox" Style="{StaticResource Input.Search}"
                                     Tag="Search by code or description (Ctrl+F)"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Search products" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                       Text="Searching…"
                                       Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                            <ListBox MaxHeight="150" Margin="0,8,0,0" BorderThickness="1"
                                     BorderBrush="{StaticResource Border.Default}"
                                     ItemsSource="{Binding SearchResults}"
                                     SelectedItem="{Binding SelectedProduct}"
                                     Visibility="{Binding SearchResults.Count, Converter={StaticResource CountToVisibility}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4">
                                            <TextBlock Text="{Binding Code}" FontFamily="{StaticResource Font.Mono}"
                                                       FontWeight="SemiBold" Width="150" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource Text.Secondary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Margin="0,10,0,0" Padding="12" CornerRadius="6"
                                    Background="{StaticResource Surface.Sunken}"
                                    Visibility="{Binding ProductDetail, Converter={StaticResource NullToCollapsed}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold">
                                        <Run Text="✔ " Foreground="{StaticResource Accent.Success}" />
                                        <Run Text="{Binding ProductDetail.Code, Mode=OneWay}"
                                             FontFamily="{StaticResource Font.Mono}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding ProductDetail.Description, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                                        <Run Text="{Binding ProductDetail.Uom, Mode=OneWay, StringFormat=UOM {0}}" />
                                        <Run Text="{Binding ProductDetail.Size, Mode=OneWay, StringFormat=· Size {0}}" />
                                        <Run Text="{Binding ProductDetail.Color, Mode=OneWay, StringFormat=· {0}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Print run -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.H2}" Text="Print run" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Batch" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input.Text}"
                                             Text="{Binding Batch, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Quantity" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input.Text}"
                                             Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Production date" Margin="0,0,0,4" />
                                    <DatePicker Height="36" SelectedDate="{Binding ProductionDate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Expiry date" Margin="0,0,0,4" />
                                    <DatePicker Height="36" SelectedDate="{Binding ExpiryDate}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Accent.Info}"
                                       Text="{Binding OverrideNotice}"
                                       Visibility="{Binding OverrideNotice, Converter={StaticResource NullToCollapsed}}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Carton start *" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                             Text="{Binding CartonFrom, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Carton end *" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                             Text="{Binding CartonTo, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Copies each" Margin="0,0,0,4" />
                                    <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                             Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                                </StackPanel>
                            </Grid>

                            <!-- Stated in words BEFORE the button, and again on it -->
                            <Border Margin="0,12,0,0" Padding="10,6" CornerRadius="6"
                                    Background="{StaticResource Surface.Sunken}">
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                           Text="{Binding RunSummary}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Printer -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.H2}" Text="Printer" Margin="0,0,0,12" />

                            <!-- An explicit ItemTemplate (not DisplayMemberPath) is what
                                 drives SelectionBoxItemTemplate, so the closed box shows
                                 the printer's name instead of the record's ToString(). -->
                            <ComboBox Height="36" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                                      AutomationProperties.Name="Printer">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text=" — Default" VerticalAlignment="Center"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Live reachability: green online, amber offline. Offline
                                 warns but never blocks — the confirm happens on Print. -->
                            <DockPanel Margin="0,6,0,0" LastChildFill="False"
                                       Visibility="{Binding PrinterStatusText, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxWidth="360"
                                           Text="{Binding PrinterStatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrinterStatusKind}" Value="Online">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding PrinterStatusKind}" Value="Offline">
                                                    <Setter Property="Foreground" Value="{StaticResource Accent.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}"
                                        Content="Retry" Command="{Binding CheckPrinterStatusCommand}" />
                            </DockPanel>

                            <!-- The command's CanExecute owns enablement; the tooltip
                                 explains a disabled button instead of leaving a mystery. -->
                            <Button Margin="0,16,0,0" Style="{StaticResource Button.Primary.Large}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding PrintCommand}"
                                    Content="{Binding PrintButtonText}"
                                    ToolTip="{Binding PrintDisabledReason}"
                                    ToolTipService.ShowOnDisabled="True" />

                            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                                    Background="{StaticResource Brush.Danger.Soft}"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Foreground="{StaticResource Accent.Danger}" TextWrapping="Wrap"
                                           Text="{Binding ErrorMessage}" />
                            </Border>

                            <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="6"
                                    Background="{StaticResource Brush.Success.Soft}"
                                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent.Success}" TextWrapping="Wrap"
                                           Text="{Binding SuccessMessage}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Recent jobs: live over SignalR, so a failure after the
                         operator moves on is visible without a refresh. Folded
                         away by default — the right-hand column belongs to the
                         label preview. -->
                    <Expander Margin="0,16,0,0" Padding="0,4,0,0" Header="Recent jobs">
                        <StackPanel>
                            <TextBlock Text="No jobs in the last day." Margin="0,4,0,4">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentJobs.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding RecentJobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,6" BorderThickness="0,0,0,1"
                                                BorderBrush="{StaticResource Border.Default}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource Font.Mono}"
                                                               FontSize="12" VerticalAlignment="Center"
                                                               Text="{Binding JobNo}" />
                                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Text="{Binding ProductCode}" />
                                                    <TextBlock Grid.Column="2" Margin="10,0,0,0" FontSize="12"
                                                               FontFamily="{StaticResource Font.Mono}"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Text.Secondary}">
                                                        <Run Text="{Binding CartonFrom, Mode=OneWay}" /><Run Text="–" /><Run Text="{Binding CartonTo, Mode=OneWay}" />
                                                    </TextBlock>
                                                    <controls:StatusPill Grid.Column="3" Margin="10,0,0,0"
                                                                         VerticalAlignment="Center"
                                                                         Status="{Binding Status}" />
                                                    <TextBlock Grid.Column="4" Margin="10,0,0,0" FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               Text="{Binding RequestedAtUtc, Converter={StaticResource UtcToLocalTime}}" />
                                                </Grid>
                                                <!-- Failed jobs say why, right in the list -->
                                                <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{StaticResource Accent.Danger}"
                                                           Text="{Binding ErrorMessage}"
                                                           ToolTip="{Binding ErrorMessage}"
                                                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- ═══ Preview column: the preview and nothing else ═══
                 Outside FormScroller, so it cannot be scrolled away. -->
            <Border x:Name="PreviewHost" Grid.Column="2"
                    Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Text.H2}"
                                   Text="Preview" Margin="0,0,0,12" />

                        <!-- Non-fatal server note about the rendered label
                             (e.g. the feedback QR is blank) -->
                        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                                Background="{StaticResource Brush.Warning.Soft}"
                                Visibility="{Binding PreviewWarning, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Foreground="{StaticResource Accent.Warning}" TextWrapping="Wrap"
                                       Text="{Binding PreviewWarning}" />
                        </Border>

                        <!-- Last child: takes every pixel the column has left. -->
                        <Border Background="{StaticResource Surface.Sunken}" CornerRadius="6" Padding="16"
                                MinHeight="420">
                            <Grid>
                                <!-- The white card is the label: the image scales
                                     uniformly to the available space and the card
                                     wraps it, so the label is as large as it can be
                                     and stays centred. -->
                                <Border Background="White" CornerRadius="4" Padding="10"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding PreviewImage, Converter={StaticResource NullToCollapsed}}">
                                    <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           AutomationProperties.Name="Label preview" />
                                </Border>

                                <!-- Said plainly when the label cannot be drawn -->
                                <TextBlock Style="{StaticResource Text.Caption}" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           MaxWidth="280" TextWrapping="Wrap" Margin="12"
                                           Text="{Binding PreviewUnavailable}"
                                           Visibility="{Binding PreviewUnavailable, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock Text="Choose a product to see the label."
                                           Style="{StaticResource Text.Caption}" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding SelectedProduct, Converter={StaticResource NullToVisible}}" />

                                <controls:BusyOverlay IsActive="{Binding IsPreviewLoading}"
                                                      Text="Rendering preview…" />
                            </Grid>
                        </Border>
                    </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
