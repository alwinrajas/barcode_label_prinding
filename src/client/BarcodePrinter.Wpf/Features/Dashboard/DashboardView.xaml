<UserControl x:Class="BarcodePrinter.Wpf.Features.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BarcodePrinter.Wpf.Controls"
             Background="{StaticResource Surface.Base}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="{StaticResource Pad.Page}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:PageHeader Grid.Row="0" Title="Dashboard"
                                 Description="Today's production at a glance.">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Text="{Binding LastUpdated, StringFormat=Updated {0:HH:mm:ss} · refreshes automatically}" />
                        <ProgressBar Width="100" VerticalAlignment="Center" Margin="0,0,12,0"
                                     Style="{StaticResource State.BusyBar}" />
                        <Button Style="{StaticResource Button.Secondary}" Height="36" Content="Refresh"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <!-- PARTIAL state: the screen auto-refreshes every 30 s, so a failed
                 refresh would otherwise leave yesterday's figures on the wall
                 looking current. The figures stay (they are still the best
                 information available); this says how old they are. -->
            <Border Grid.Row="1" Style="{StaticResource State.Banner}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource State.BannerText}" FontWeight="SemiBold"
                               Text="{Binding ErrorMessage}" />
                    <TextBlock Style="{StaticResource State.BannerText}" FontSize="12"
                               Text="{Binding LastUpdated, StringFormat=These figures were last updated at {0:HH:mm:ss}.}" />
                </StackPanel>
            </Border>

            <!-- Alerts (FRD: system notifications) -->
            <!-- ═══ Needs attention ═══
                 One card, one row per item. Four full-width coloured blocks
                 dominated the page and pushed the figures below the fold, which
                 made a routine warning look like an outage. A severity rail plus
                 a tight row keeps the same information scannable and lets the
                 numbers stay visible. -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"
                    Margin="{StaticResource Gap.Below.LG}"
                    Visibility="{Binding HasAlerts, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <DockPanel Margin="16,14,16,10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.H2}"
                                   Text="Needs attention" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Left" Margin="8,0,0,0" Padding="7,1" CornerRadius="9"
                                VerticalAlignment="Center"
                                Background="{StaticResource Surface.Sunken}">
                            <TextBlock Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                       Text="{Binding Alerts.Count}" />
                        </Border>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Alerts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Hairline between rows, not around each item:
                                     a list reads as one thing, four boxes read as
                                     four problems. -->
                                <Border BorderThickness="0,1,0,0"
                                        BorderBrush="{StaticResource Border.Default}"
                                        Padding="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity is a rail, so colour marks the
                                             row without tinting the whole card. -->
                                        <Rectangle Grid.Column="0">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Fill" Value="{StaticResource Accent.Warning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Fill" Value="{StaticResource Accent.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>

                                        <StackPanel Grid.Column="1" Margin="13,10,12,10"
                                                    VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" Text="{Binding Title}" />
                                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                       Margin="0,1,0,0" Text="{Binding Detail}" />
                                        </StackPanel>

                                        <Button Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0"
                                                Height="30" Padding="14,0" Content="Open"
                                                Command="{Binding DataContext.NavigateCommand,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding NavigateTo}"
                                                Visibility="{Binding NavigateTo, Converter={StaticResource NullToCollapsed}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- KPI stat cards: even 12 px gutters via explicit gap columns
                 (a UniformGrid + per-tile margin made the last tile wider). -->
            <Grid Grid.Row="3" Margin="{StaticResource Gap.Below.LG}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="LABELS TODAY" />
                        <TextBlock Style="{StaticResource Text.Display}" Foreground="{StaticResource Brand.Primary}"
                                   Text="{Binding Kpis.LabelsToday, StringFormat=N0, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="{Binding TrendSummary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="PRINT JOBS TODAY" />
                        <TextBlock Style="{StaticResource Text.Display}"
                                   Text="{Binding Kpis.JobsToday, StringFormat=N0, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="{Binding Kpis.ReprintsToday, Converter={StaticResource Plural}, ConverterParameter=reprint}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="{StaticResource Pad.Card}">
                    <Border.Style>
                        <!-- The whole card turns danger-soft when something
                             failed, so the tile reads at a glance. -->
                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                            <Setter Property="Background" Value="{StaticResource Brush.Danger.Soft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kpis.FailedToday, FallbackValue=0}" Value="0">
                                    <Setter Property="Background" Value="{StaticResource Surface.Card}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="FAILED TODAY" />
                        <TextBlock Text="{Binding Kpis.FailedToday, StringFormat=N0, FallbackValue=0}">
                            <TextBlock.Style>
                                <!-- Green when nothing failed, red when something did:
                                     the number alone should not need interpreting. -->
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Display}">
                                    <Setter Property="Foreground" Value="{StaticResource Accent.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kpis.FailedToday, FallbackValue=0}" Value="0">
                                            <Setter Property="Foreground" Value="{StaticResource Accent.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Jobs needing attention" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="ACTIVE PRODUCTS" />
                        <TextBlock Style="{StaticResource Text.Display}"
                                   Text="{Binding Kpis.ActiveProducts, StringFormat=N0, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="Available to print" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="8" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="OPERATORS TODAY" />
                        <TextBlock Style="{StaticResource Text.Display}"
                                   Text="{Binding Kpis.ActiveUsersToday, StringFormat=N0, FallbackValue=0}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="People who printed" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Trend + printer health: proportional split instead of a
                 hard-coded 380 px right column. -->
            <Grid Grid.Row="4" Margin="{StaticResource Gap.Below.LG}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" MinWidth="280" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="LABELS — LAST 7 DAYS"
                                   Margin="{StaticResource Gap.Below.MD}" />
                        <ItemsControl ItemsSource="{Binding Trend}" Height="150">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <!-- Bar height is a fraction of the peak day,
                                             computed server-side data + VM scaling -->
                                        <Border Grid.Row="0" VerticalAlignment="Bottom" CornerRadius="4,4,0,0"
                                                MinHeight="2" ToolTip="{Binding Labels}">
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource FractionOfHeight}">
                                                    <Binding Path="HeightFraction" />
                                                    <Binding Path="ActualHeight"
                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Border.Height>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Border.Default}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Brand.Primary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" Margin="0,6,0,0"
                                                   Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                                   Text="{Binding Labels, StringFormat=N0}" />
                                        <TextBlock Grid.Row="2" HorizontalAlignment="Center"
                                                   Style="{StaticResource Text.Caption}" Text="{Binding Label}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="PRINTERS"
                                   Margin="{StaticResource Gap.Below.SM}" />
                        <ItemsControl ItemsSource="{Binding Printers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,10" LastChildFill="True">
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Accent.Danger}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FailedToday}" Value="0">
                                                            <Setter Property="Fill" Value="{StaticResource Accent.Success}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Text.Caption}">
                                                <Run Text="{Binding JobsToday, Mode=OneWay, Converter={StaticResource Plural}, ConverterParameter=job}" /><Run Text=" today" />
                                                <Run Text="{Binding DispatchMode, Mode=OneWay, StringFormat=· {0}}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Accent.Danger}"
                                                       Text="{Binding LastError}"
                                                       Visibility="{Binding LastError, Converter={StaticResource NullToCollapsed}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="No printers configured yet."
                                   Visibility="{Binding Printers.Count, Converter={StaticResource ZeroToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent jobs: proper header row; columns aligned between header
                 and rows via shared size groups. -->
            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <DockPanel LastChildFill="False" Margin="{StaticResource Gap.Below.SM}">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Label}"
                                   Text="RECENT PRINT JOBS" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Height="28"
                                Content="View all"
                                Command="{Binding NavigateCommand}" CommandParameter="history" />
                    </DockPanel>

                    <Grid Margin="12,0,12,6"
                          Visibility="{Binding RecentJobs.Count, Converter={StaticResource CountToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentJob" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentProduct" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentLabels" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentPrinter" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentStatus" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Text="Job" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Text="Product" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Text="Description" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Text="Labels" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="4" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Text="Printer" Margin="0,0,16,0" />
                        <TextBlock Grid.Column="5" Style="{StaticResource Text.Caption}" FontWeight="SemiBold"
                                   Text="Status" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentJobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface.Sunken}" CornerRadius="6"
                                        Padding="12,8" Margin="{StaticResource Gap.Below.SM}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentJob" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentProduct" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentLabels" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentPrinter" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="RecentStatus" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Mono}" FontSize="12"
                                                   Foreground="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"
                                                   Text="{Binding JobNo}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                                                   Text="{Binding ProductCode}" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Margin="0,0,16,0" Text="{Binding Description}" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"
                                                   Text="{Binding LabelCount, Converter={StaticResource Plural}, ConverterParameter=label}" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource Text.Caption}"
                                                   VerticalAlignment="Center" Margin="0,0,16,0"
                                                   Text="{Binding PrinterName}" />
                                        <controls:StatusPill Grid.Column="5" Status="{Binding Status}"
                                                             HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="Nothing printed in the last 7 days."
                               Visibility="{Binding RecentJobs.Count, Converter={StaticResource ZeroToVisibility}}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
