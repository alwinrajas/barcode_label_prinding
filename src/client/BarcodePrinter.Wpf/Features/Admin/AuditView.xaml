<UserControl x:Class="BarcodePrinter.Wpf.Features.Admin.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource Text.H1}" Text="Audit Log" Margin="0,0,0,12" />

        <Border Grid.Row="1" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Period" Margin="0,0,0,4" />
                    <ComboBox Width="150" Height="36" ItemsSource="{Binding RangePresets}"
                              SelectedItem="{Binding SelectedRange}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Action" Margin="0,0,0,4" />
                    <ComboBox Width="220" Height="36" ItemsSource="{Binding Actions}"
                              SelectedItem="{Binding SelectedAction}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Severity" Margin="0,0,0,4" />
                    <ComboBox Width="140" Height="36" ItemsSource="{Binding Severities}"
                              SelectedItem="{Binding SelectedSeverity}" />
                </StackPanel>
                <Button VerticalAlignment="Bottom" Height="36" Padding="14,0" Content="Refresh"
                        Command="{Binding SearchCommand}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Surface.Card}" BorderBrush="{StaticResource Border.Default}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                          RowHeight="38" SelectionMode="Single" EnableRowVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When"
                                            Binding="{Binding OccurredAtUtc, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="160" />
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="140" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200" />
                        <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120" />
                        <DataGridTextColumn Header="Reference" Binding="{Binding EntityId}" Width="180" />
                        <DataGridTemplateColumn Header="Severity" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9" Padding="8,2" HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Surface.Sunken}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Security">
                                                        <Setter Property="Background" Value="{StaticResource Accent.Warning}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Severity}" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Workstation" Binding="{Binding Workstation}" Width="*" />
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface.Sunken}" Padding="14">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="BEFORE" />
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource Font.Mono}" Text="{Binding BeforeJson}" />
                                    <TextBlock Style="{StaticResource Text.Label}" Text="AFTER" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                               FontFamily="{StaticResource Font.Mono}" Text="{Binding AfterJson}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                               Text="{Binding CorrelationId, StringFormat=Correlation: {0}}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource Brand.Primary}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Accent.Danger}"
                       Text="{Binding ErrorMessage}" />
            <Button HorizontalAlignment="Center" Style="{StaticResource Button.Primary}" Content="Load more"
                    Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
