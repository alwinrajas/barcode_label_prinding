<UserControl x:Class="BarcodePrinter.Wpf.Features.Admin.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BarcodePrinter.Wpf.Controls"
             xmlns:admin="clr-namespace:BarcodePrinter.Wpf.Features.Admin"
             Background="{StaticResource Surface.Base}">
    <UserControl.Resources>
        <admin:AuditDiffConverter x:Key="AuditDiff" />
        <admin:SeverityToPillStatusConverter x:Key="SeverityPill" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Audit Log" Description="Who changed what, when." />

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}"
                Margin="{StaticResource Gap.Below.MD}">
            <WrapPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Period" Margin="0,0,0,4" />
                    <ComboBox Width="150" ItemsSource="{Binding RangePresets}"
                              SelectedItem="{Binding SelectedRange}"
                              AutomationProperties.Name="Period" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Action" Margin="0,0,0,4" />
                    <ComboBox Width="220" ItemsSource="{Binding Actions}"
                              SelectedItem="{Binding SelectedAction}"
                              AutomationProperties.Name="Action" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Severity" Margin="0,0,0,4" />
                    <ComboBox Width="140" ItemsSource="{Binding Severities}"
                              SelectedItem="{Binding SelectedSeverity}"
                              AutomationProperties.Name="Severity" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text=" " Margin="0,0,0,4" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Refresh"
                            Command="{Binding SearchCommand}" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <DataGrid ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="When"
                                            Binding="{Binding OccurredAtUtc, StringFormat=dd/MM/yyyy HH:mm:ss}"
                                            Width="160" />
                        <DataGridTextColumn Header="User" Binding="{Binding Username}" Width="140" />
                        <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="200" />
                        <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120" />
                        <DataGridTextColumn Header="Reference" Binding="{Binding EntityId}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Severity" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:StatusPill VerticalAlignment="Center"
                                                         Status="{Binding Severity, Converter={StaticResource SeverityPill}}"
                                                         Text="{Binding Severity}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Workstation" Binding="{Binding Workstation}" Width="*"
                                            MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>

                    <!-- WHAT CHANGED: a field/old/new table, not a JSON dump. The
                         raw payload stays one click away for support. -->
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface.Sunken}" Padding="{StaticResource Pad.Card}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.Label}" Text="WHAT CHANGED" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}"
                                                   FontWeight="SemiBold" Text="FIELD" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                                                   FontWeight="SemiBold" Margin="12,0,0,0" Text="OLD" />
                                        <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}"
                                                   FontWeight="SemiBold" Margin="12,0,0,0" Text="NEW" />
                                    </Grid>
                                    <Border Height="1" Margin="0,4,0,0"
                                            Background="{StaticResource Border.Default}" />

                                    <ItemsControl x:Name="Diff" Margin="0,4,0,0">
                                        <ItemsControl.ItemsSource>
                                            <MultiBinding Converter="{StaticResource AuditDiff}">
                                                <Binding Path="BeforeJson" />
                                                <Binding Path="AfterJson" />
                                            </MultiBinding>
                                        </ItemsControl.ItemsSource>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}"
                                                               FontSize="13" TextWrapping="Wrap"
                                                               Text="{Binding Field}" />
                                                    <TextBlock Grid.Column="1" Style="{StaticResource Text.Mono}"
                                                               FontSize="12" Margin="12,0,0,0" TextWrapping="Wrap"
                                                               Foreground="{StaticResource Text.Secondary}"
                                                               Text="{Binding OldValue}" />
                                                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Mono}"
                                                               FontSize="12" Margin="12,0,0,0" TextWrapping="Wrap"
                                                               Text="{Binding NewValue}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                                               Text="No field-level detail was recorded for this entry. The raw payload, if any, is below."
                                               Visibility="{Binding HasItems, ElementName=Diff, Converter={StaticResource InverseBoolToVisibility}}" />

                                    <Expander Header="Raw data" Margin="0,10,0,0">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Style="{StaticResource Text.Label}" Text="BEFORE" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       Text="{Binding BeforeJson, TargetNullValue=—}" />
                                            <TextBlock Style="{StaticResource Text.Label}" Text="AFTER" Margin="0,8,0,0" />
                                            <TextBlock Style="{StaticResource Text.Mono}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Foreground="{StaticResource Text.Secondary}"
                                                       Text="{Binding AfterJson, TargetNullValue=—}" />
                                        </StackPanel>
                                    </Expander>

                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0">
                                        <Run Text="{Binding CorrelationId, Mode=OneWay, StringFormat=Reference {0}}" />
                                        <Run Text="{Binding Ip, Mode=OneWay, StringFormat=· from {0}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>

                <controls:EmptyState Glyph="&#xE7BA;" Title="No audit entries"
                                     Message="Nothing matches these filters. Widen the period, or clear the action and severity."
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

                <controls:ErrorState Message="{Binding LoadErrorMessage}"
                                     Reference="{Binding LoadErrorReference}"
                                     RetryCommand="{Binding SearchCommand}"
                                     Visibility="{Binding LoadFailed, Converter={StaticResource BoolToVisibility}}" />

                <ProgressBar Style="{StaticResource State.BusyBar}" />
            </Grid>
        </Border>

        <controls:LoadMoreFooter Grid.Row="3" HasMore="{Binding HasMore}" IsLoading="{Binding IsBusy}"
                                 Command="{Binding LoadMoreCommand}" CountText="{Binding CountText}" />
    </Grid>
</UserControl>
