<UserControl x:Class="BarcodePrinter.Wpf.Features.Admin.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.H1}" Text="Users"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="＋ New user"
                        Command="{Binding NewUserCommand}"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                          RowHeight="42" SelectionMode="Single" EnableRowVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" />
                        <DataGridTextColumn Header="Full name" Binding="{Binding FullName}" Width="*" MinWidth="180" />
                        <DataGridTextColumn Header="Roles"
                                            Binding="{Binding Roles, Converter={StaticResource JoinList}}" Width="170" />
                        <DataGridTextColumn Header="Last sign-in"
                                            Binding="{Binding LastLoginAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="140" />
                        <DataGridTemplateColumn Header="Status" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Accent.Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource Text.Secondary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Active" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Inactive" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Width="380" Style="{StaticResource Card}" Padding="20"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H1}" Text="{Binding EditorTitle}" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Username *" Margin="0,16,0,4" />
                    <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                             Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsNewUser}" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Full name *" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource Input.Text}"
                             Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Email" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource Input.Text}"
                             Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Visibility="{Binding IsNewUser, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Initial password *" Margin="0,12,0,4" />
                        <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource Input.Password}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="The user must change this at first sign-in." />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Label}" Text="Roles *" Margin="0,16,0,4" />
                    <ItemsControl ItemsSource="{Binding Roles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,4" IsChecked="{Binding IsSelected}" Content="{Binding Name}"
                                          FontFamily="{StaticResource Font.Ui}" FontSize="14" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Accent.Danger}" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Accent.Success}" TextWrapping="Wrap"
                               Text="{Binding StatusMessage}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="Save"
                                Command="{Binding SaveCommand}"
                                CommandParameter="{Binding ElementName=NewPasswordBox}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="8,0,0,0" Height="40" Padding="14,0" Content="Activate / Deactivate"
                                Command="{Binding ToggleActiveCommand}"
                                Visibility="{Binding CanDeactivate, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Border Margin="0,20,0,0" Padding="0,16,0,0"
                            BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0"
                            Visibility="{Binding CanResetPassword, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Visibility="{Binding IsNewUser, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Reset password" />
                            <PasswordBox x:Name="ResetPasswordBox" Style="{StaticResource Input.Password}" Margin="0,6,0,0" />
                            <Button Margin="0,8,0,0" Height="34" Padding="12,0" HorizontalAlignment="Left"
                                    Content="Reset password" Command="{Binding ResetPasswordCommand}"
                                    CommandParameter="{Binding ElementName=ResetPasswordBox}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
            <!-- LOADING: spans the whole screen at the top so it reads as "this page
             is fetching", without covering the data already on it. -->
        <ProgressBar Grid.RowSpan="99" Grid.ColumnSpan="99" Margin="-24,-24,-24,0"
                     Style="{StaticResource State.BusyBar}" />
</Grid>
</UserControl>
