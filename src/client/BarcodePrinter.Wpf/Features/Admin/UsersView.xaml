<UserControl x:Class="BarcodePrinter.Wpf.Features.Admin.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BarcodePrinter.Wpf.Controls"
             Background="{StaticResource Surface.Base}">
    <!-- Escape closes the drawer; the command itself asks before discarding
         unsaved edits, so the key is never a silent data loss. -->
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseEditorCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:PageHeader Grid.Row="0" Title="Users" Description="Accounts and access.">
                <controls:PageHeader.Actions>
                    <Button Style="{StaticResource Button.Primary}" Content="Add user"
                            Command="{Binding NewUserCommand}"
                            Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <TextBox Grid.Row="1" Width="320" HorizontalAlignment="Left"
                     Margin="{StaticResource Gap.Below.MD}"
                     Style="{StaticResource Input.Search}"
                     Tag="Search name, username, email or role…"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search users" />

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Full name" Binding="{Binding FullName}"
                                                Width="*" MinWidth="180" />
                            <DataGridTextColumn Header="Roles"
                                                Binding="{Binding Roles, Converter={StaticResource JoinList}}"
                                                Width="200" />
                            <DataGridTextColumn Header="Last sign-in" Width="150"
                                                Binding="{Binding LastLoginAtUtc, StringFormat=dd/MM/yyyy HH:mm, TargetNullValue=—}" />
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <controls:StatusPill Status="Completed" Text="Active"
                                                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}" />
                                            <controls:StatusPill Status="" Text="Inactive"
                                                                 Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:EmptyState Glyph="&#xE77B;" Title="No users to show"
                                         Message="Nothing matches this search. Clear the search box, or add the account you were looking for."
                                         Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <controls:EmptyState.Action>
                            <Button Style="{StaticResource Button.Primary}" Content="Add user"
                                    Command="{Binding NewUserCommand}"
                                    Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
                        </controls:EmptyState.Action>
                    </controls:EmptyState>

                    <controls:ErrorState Message="{Binding LoadErrorMessage}"
                                         Reference="{Binding LoadErrorReference}"
                                         RetryCommand="{Binding RetryLoadCommand}"
                                         Visibility="{Binding LoadFailed, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- DRAWER: 400 px, header + scrolling body + Cancel/Save footer. -->
        <Border Grid.Column="1" Width="400" Margin="16,0,0,0" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="{StaticResource Pad.Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.H2}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="{Binding EditorTitle}" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE711;"
                            Command="{Binding CloseEditorCommand}"
                            AutomationProperties.Name="Close user editor" ToolTip="Close" />
                </Grid>
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                        Background="{StaticResource Border.Default}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="Username *" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                 Text="{Binding EditUsername, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsNewUser}"
                                 AutomationProperties.Name="Username" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="Full name *" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}"
                                 Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Full name" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="Email" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}"
                                 Text="{Binding EditEmail, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Email" />

                        <StackPanel Visibility="{Binding IsNewUser, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Initial password *" Margin="0,12,0,4" />
                            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource Input.Password}"
                                         AutomationProperties.Name="Initial password" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="The user must change this at first sign-in." />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Text.Label}" Text="Roles *" Margin="0,16,0,4" />
                        <ItemsControl ItemsSource="{Binding Roles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Margin="0,4" IsChecked="{Binding IsSelected}" Content="{Binding Name}"
                                              ToolTip="{Binding Code}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{StaticResource Brush.Danger.Soft}" CornerRadius="6"
                                Padding="10,8" Margin="0,12,0,0"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Accent.Danger}" Text="{Binding ErrorMessage}" />
                        </Border>

                        <!-- Account state: a separate, deliberate action rather than a
                             checkbox that saves along with the name. -->
                        <Border Margin="0,20,0,0" Padding="0,16,0,0"
                                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0"
                                Visibility="{Binding CanDeactivate, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Visibility="{Binding IsNewUser, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Account state" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Deactivating ends the user's sessions immediately." />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource Button.Secondary}"
                                        Content="Activate / Deactivate" Command="{Binding ToggleActiveCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- Reset password: never logged, never echoed back. -->
                        <Border Margin="0,20,0,0" Padding="0,16,0,0"
                                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0"
                                Visibility="{Binding CanResetPassword, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Visibility="{Binding IsNewUser, Converter={StaticResource InverseBoolToVisibility}}">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Reset password" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="The user's sessions end and they must set a new password at next sign-in." />
                                <PasswordBox x:Name="ResetPasswordBox" Style="{StaticResource Input.Password}"
                                             Margin="0,8,0,0" AutomationProperties.Name="New password" />
                                <Button Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource Button.Secondary}"
                                        Content="Reset password" Command="{Binding ResetPasswordCommand}"
                                        CommandParameter="{Binding ElementName=ResetPasswordBox}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0"
                        Padding="{StaticResource Pad.Card}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Secondary}" Content="Cancel" MinWidth="88"
                                Command="{Binding CloseEditorCommand}" />
                        <Button Style="{StaticResource Button.Primary}" Content="Save" MinWidth="88"
                                Margin="8,0,0,0" Command="{Binding SaveCommand}"
                                CommandParameter="{Binding ElementName=NewPasswordBox}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <controls:BusyOverlay Grid.ColumnSpan="2" IsActive="{Binding IsBusy}" Text="Working…" />
    </Grid>
</UserControl>
