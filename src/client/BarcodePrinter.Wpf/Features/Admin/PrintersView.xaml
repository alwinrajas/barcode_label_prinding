<UserControl x:Class="BarcodePrinter.Wpf.Features.Admin.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.H1}" Text="Printers"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="＋ New printer"
                        Command="{Binding NewPrinterCommand}"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>

            <Border Grid.Row="1" Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="8">
                <DataGrid ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                          RowHeight="42" SelectionMode="Single"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="130" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="150" />
                        <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionType}" Width="130" />
                        <DataGridTextColumn Header="Dispatched from" Binding="{Binding DispatchMode}" Width="130" />
                        <DataGridTextColumn Header="Address" Width="180">
                            <DataGridTextColumn.Binding>
                                <MultiBinding StringFormat="{}{0}{1}">
                                    <Binding Path="Host" TargetNullValue="" />
                                    <Binding Path="WindowsPrinterName" TargetNullValue="" />
                                </MultiBinding>
                            </DataGridTextColumn.Binding>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Status" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Accent.Success}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource Text.Secondary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Active" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Inactive" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="★" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Accent.Warning}" ToolTip="Default printer"
                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Width="380" Style="{StaticResource Card}" Padding="20"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.H1}" Text="{Binding EditorTitle}" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Code *" Margin="0,16,0,4" />
                    <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                             Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Name *" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource Input.Text}"
                             Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Location" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource Input.Text}"
                             Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Connection type *" Margin="0,12,0,4" />
                    <ComboBox Height="36" ItemsSource="{Binding ConnectionTypes}"
                              SelectedItem="{Binding EditConnectionType}" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Dispatched from *" Margin="0,12,0,4" />
                    <ComboBox Height="36" ItemsSource="{Binding DispatchModes}"
                              SelectedItem="{Binding EditDispatchMode}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Server: the server sends jobs directly. Client: the workstation the printer is attached to sends them." />

                    <StackPanel Visibility="{Binding ShowNetworkFields, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Label}" Text="IP address / host *" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}"
                                 Text="{Binding EditHost, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Text.Label}" Text="Port" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                 Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowWindowsFields, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Windows printer name *" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}"
                                 Text="{Binding EditWindowsPrinterName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Exactly as it appears in Windows Printers &amp; scanners." />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowWorkstation, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Text.Label}" Text="Owner workstation *" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}"
                                 Text="{Binding EditOwnerWorkstation, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="That PC must be running the application for its jobs to print." />
                    </StackPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="DPI" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                     Text="{Binding EditDpi, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Language" Margin="0,0,0,4" />
                            <ComboBox Height="36" ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding EditLanguage}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Margin="0,14,0,0" Content="Printer reports its status (~HQES)"
                              IsChecked="{Binding EditSupportsStatusQuery}"
                              FontFamily="{StaticResource Font.Ui}" FontSize="13" />
                    <CheckBox Margin="0,8,0,0" Content="Active"
                              IsChecked="{Binding EditIsActive}"
                              FontFamily="{StaticResource Font.Ui}" FontSize="13" />

                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Accent.Danger}" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Accent.Success}" TextWrapping="Wrap"
                               Text="{Binding StatusMessage}" />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource Button.Primary}" Content="Save"
                                Command="{Binding SaveCommand}" />
                        <Button Margin="8,0,0,0" Height="40" Padding="12,0" Content="Test print"
                                Command="{Binding TestCommand}" />
                        <Button Margin="8,0,0,0" Height="40" Padding="12,0" Content="Set default"
                                Command="{Binding SetDefaultCommand}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
            <!-- LOADING: spans the whole screen at the top so it reads as "this page
             is fetching", without covering the data already on it. -->
        <ProgressBar Grid.RowSpan="99" Grid.ColumnSpan="99" Margin="-24,-24,-24,0"
                     Style="{StaticResource State.BusyBar}" />
</Grid>
</UserControl>
