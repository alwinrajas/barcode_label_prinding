<UserControl x:Class="BarcodePrinter.Wpf.Features.Admin.PrintersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BarcodePrinter.Wpf.Controls"
             Background="{StaticResource Surface.Base}">
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseEditorCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <!-- The app-wide ComboBox template is selection-only (it has no
             PART_EditableTextBox), so an editable combo needs its own template.
             Same metrics, same focus treatment — only the text host is added,
             because a Windows queue on ANOTHER PC will never be in this list
             and must still be typeable. -->
    </UserControl.Resources>

    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:PageHeader Grid.Row="0" Title="Printers"
                                 Description="Devices, connectivity and defaults.">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Secondary}" Content="Refresh"
                                Command="{Binding RefreshCommand}" />
                        <Button Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Content="Add printer"
                                Command="{Binding NewPrinterCommand}"
                                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Connection" Binding="{Binding ConnectionLabel}" Width="120" />
                            <DataGridTextColumn Header="Address" Binding="{Binding AddressLabel}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Dispatched from" Binding="{Binding DispatchLabel}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Default" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DefaultGlyph}" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Accent.Warning}"
                                                   ToolTip="Default printer"
                                                   AutomationProperties.Name="{Binding DefaultAutomationName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText}" Width="110" />
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:StatusPill VerticalAlignment="Center"
                                                             Status="{Binding StatusKind}"
                                                             Text="{Binding StatusText}"
                                                             ToolTip="{Binding StatusDetail}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:EmptyState Glyph="&#xE749;" Title="No printers configured"
                                         Message="Add the label printers this site prints to. Network printers are driven by the server; Windows queues print from the PC they are installed on."
                                         Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <controls:EmptyState.Action>
                            <Button Style="{StaticResource Button.Primary}" Content="Add printer"
                                    Command="{Binding NewPrinterCommand}"
                                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
                        </controls:EmptyState.Action>
                    </controls:EmptyState>

                    <controls:ErrorState Message="{Binding LoadErrorMessage}"
                                         Reference="{Binding LoadErrorReference}"
                                         RetryCommand="{Binding RetryLoadCommand}"
                                         Visibility="{Binding LoadFailed, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- DRAWER: 400 px, header + scrolling body + Cancel/Save footer. -->
        <Border Grid.Column="1" Width="400" Margin="16,0,0,0" Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="{StaticResource Pad.Card}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.H2}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Text="{Binding EditorTitle}" />
                    <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE711;"
                            Command="{Binding CloseEditorCommand}"
                            AutomationProperties.Name="Close printer editor" ToolTip="Close" />
                </Grid>
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1"
                        Background="{StaticResource Border.Default}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,4,16,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Label}" Text="Code *" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                 Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Printer code" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="Name *" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}"
                                 Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Printer name" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="Location" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource Input.Text}"
                                 Text="{Binding EditLocation, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Location" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="Connection type *" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding ConnectionTypes}"
                                  SelectedItem="{Binding EditConnectionType}"
                                  AutomationProperties.Name="Connection type" />

                        <TextBlock Style="{StaticResource Text.Label}" Text="Dispatched from *" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding DispatchModes}"
                                  SelectedItem="{Binding EditDispatchMode}"
                                  AutomationProperties.Name="Dispatched from" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Server: the server sends jobs directly. Client: the workstation the printer is attached to sends them." />

                        <StackPanel Visibility="{Binding ShowNetworkFields, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Label}" Text="IP address / host *" Margin="0,12,0,4" />
                            <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                     Text="{Binding EditHost, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="IP address or host" />
                            <TextBlock Style="{StaticResource Text.Label}" Text="Port" Margin="0,12,0,4" />
                            <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                     Text="{Binding EditPort, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Port" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowWindowsFields, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Windows printer name *" Margin="0,12,0,4" />
                            <!-- Editable: the queue may live on another PC and so
                                 will not appear in this machine's list. -->
                            <ComboBox Style="{StaticResource Input.ComboBox.Editable}"
                                      ItemsSource="{Binding InstalledPrinters}"
                                      Text="{Binding EditWindowsPrinterName, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Windows printer name" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Exactly as it appears in Windows Printers &amp; scanners." />
                            <Border Background="{StaticResource Brush.Warning.Soft}" CornerRadius="6"
                                    Padding="10,8" Margin="0,8,0,0"
                                    Visibility="{Binding WindowsPrinterHint, Converter={StaticResource NullToCollapsed}}">
                                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                           Foreground="{StaticResource Text.Primary}"
                                           Text="{Binding WindowsPrinterHint}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Visibility="{Binding ShowWorkstation, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Owner workstation *" Margin="0,12,0,4" />
                            <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                     Text="{Binding EditOwnerWorkstation, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Owner workstation" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="That PC must be running the application for its jobs to print." />
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource Text.Label}" Text="DPI" Margin="0,0,0,4" />
                                <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                         Text="{Binding EditDpi, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Dots per inch" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Language" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Languages}"
                                          SelectedItem="{Binding EditLanguage}"
                                          AutomationProperties.Name="Printer language" />
                            </StackPanel>
                        </Grid>

                        <CheckBox Margin="0,14,0,0" Content="Printer reports its status (~HQES)"
                                  IsChecked="{Binding EditSupportsStatusQuery}" />
                        <CheckBox Margin="0,8,0,0" Content="Active"
                                  IsChecked="{Binding EditIsActive}" />

                        <Border Background="{StaticResource Brush.Danger.Soft}" CornerRadius="6"
                                Padding="10,8" Margin="0,12,0,0"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}">
                            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                       Foreground="{StaticResource Accent.Danger}" Text="{Binding ErrorMessage}" />
                        </Border>

                        <!-- Device actions act on the saved printer, not on the
                             unsaved form, so they live apart from Save. -->
                        <Border Margin="0,20,0,0" Padding="0,16,0,0"
                                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0"
                                Visibility="{Binding CanUseDeviceActions, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Device actions" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="A test label proves the path from this app to the paper. Client-dispatched Windows printers can only be tested from the PC they are attached to." />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{StaticResource Button.Secondary}" Content="Test print"
                                            Command="{Binding TestCommand}" />
                                    <Button Style="{StaticResource Button.Secondary}" Margin="8,0,0,0"
                                            Content="Set default" Command="{Binding SetDefaultCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="2" BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0"
                        Padding="{StaticResource Pad.Card}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Secondary}" Content="Cancel" MinWidth="88"
                                Command="{Binding CloseEditorCommand}" />
                        <Button Style="{StaticResource Button.Primary}" Content="Save" MinWidth="88"
                                Margin="8,0,0,0" Command="{Binding SaveCommand}"
                                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <controls:BusyOverlay Grid.ColumnSpan="2" IsActive="{Binding IsBusy}" Text="Working…" />
    </Grid>
</UserControl>
