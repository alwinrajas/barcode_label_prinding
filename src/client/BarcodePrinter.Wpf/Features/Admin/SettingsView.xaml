<UserControl x:Class="BarcodePrinter.Wpf.Features.Admin.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.H1}" Text="Settings"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Height="36" Padding="14,0" Content="Reload"
                    Command="{Binding LoadCommand}" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Groups}" MaxWidth="820" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.H1}" FontSize="16" Text="{Binding Name}" />
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="260" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Label}" />
                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                                               Text="{Binding Description}" />
                                                </StackPanel>
                                                <Grid Grid.Column="1">
                                                    <TextBox Style="{StaticResource Input.Text}"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Visibility="{Binding IsBool, Converter={StaticResource InverseBoolToVisibility}}" />
                                                    <CheckBox VerticalAlignment="Center" Content="Enabled"
                                                              IsChecked="{Binding BoolValue}"
                                                              FontFamily="{StaticResource Font.Ui}" FontSize="14"
                                                              Visibility="{Binding IsBool, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Accent.Danger}"
                       TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Accent.Success}"
                       Text="{Binding StatusMessage}" />
            <Button Margin="0,10,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Primary}"
                    Content="Save changes" Command="{Binding SaveCommand}"
                    Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
            <!-- LOADING: spans the whole screen at the top so it reads as "this page
             is fetching", without covering the data already on it. -->
        <ProgressBar Grid.RowSpan="99" Grid.ColumnSpan="99" Margin="-24,-24,-24,0"
                     Style="{StaticResource State.BusyBar}" />
</Grid>
</UserControl>
