<UserControl x:Class="BarcodePrinter.Wpf.Features.Admin.RolesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Role list -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.H1}" Text="Roles"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Height="34" Padding="12,0" Content="＋ New"
                        Command="{Binding NewRoleCommand}"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>
            <Border Grid.Row="1" Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="8">
                <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                         BorderThickness="0" Background="Transparent" Padding="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="8,6">
                                <TextBlock Style="{StaticResource Text.Body}" FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Style="{StaticResource Text.Caption}">
                                    <Run Text="{Binding Code, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                                    <Run Text="{Binding PermissionCount, Mode=OneWay, StringFormat=· {0} permissions}" />
                                    <Run Text="{Binding UserCount, Mode=OneWay, StringFormat=· {0} users}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Permission matrix -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20"
                Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Style="{StaticResource Text.H1}" Text="{Binding EditorTitle}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Code *" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                                     Text="{Binding EditCode, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsSystemRole, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Name *" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Text}"
                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Text.Label}" Text="PERMISSIONS" Margin="0,20,0,8" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Modules}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface.Sunken}" CornerRadius="6"
                                        Padding="12,10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Body}"
                                                       FontWeight="SemiBold" Text="{Binding Module}" />
                                            <Button DockPanel.Dock="Right" Content="Toggle all" Height="24" Padding="8,0"
                                                    FontSize="11" Background="Transparent"
                                                    Command="{Binding DataContext.SelectAllInModuleCommand,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,8,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Margin="0,4,20,4" MinWidth="190"
                                                              IsChecked="{Binding IsSelected}"
                                                              Content="{Binding DisplayName}"
                                                              ToolTip="{Binding Code}"
                                                              FontFamily="{StaticResource Font.Ui}" FontSize="13" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <!-- Diff before save: the admin sees exactly what changes -->
                    <Border Background="{StaticResource Surface.Sunken}" CornerRadius="6" Padding="10,6"
                            Visibility="{Binding PendingChangeSummary, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Accent.Warning}"
                                   Text="{Binding PendingChangeSummary}" />
                    </Border>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Accent.Danger}" TextWrapping="Wrap"
                               Text="{Binding ErrorMessage}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Accent.Success}" Text="{Binding StatusMessage}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibility}}">
                        <Button Style="{StaticResource Button.Primary}" Content="Save role"
                                Command="{Binding SaveCommand}" />
                        <Button Margin="8,0,0,0" Height="40" Padding="14,0" Content="Delete role"
                                Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding IsSystemRole, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
            <!-- LOADING: spans the whole screen at the top so it reads as "this page
             is fetching", without covering the data already on it. -->
        <ProgressBar Grid.RowSpan="99" Grid.ColumnSpan="99" Margin="-24,-24,-24,0"
                     Style="{StaticResource State.BusyBar}" />
</Grid>
</UserControl>
