<UserControl x:Class="BarcodePrinter.Wpf.Features.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BarcodePrinter.Wpf.Controls"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="{StaticResource Pad.Page}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Grid.Row="0" Title="Reports"
                             Description="Production totals and detail extracts.">
            <controls:PageHeader.Actions>
                <StackPanel Orientation="Horizontal">
                    <!-- Report.Print is its own permission: exporting data and putting
                         it on paper are separately grantable (A-24 / §13). -->
                    <Button Style="{StaticResource Button.Secondary}" Height="36" Content="Print…"
                            Command="{Binding PrintReportCommand}"
                            Visibility="{Binding CanPrint, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Content="Export .xlsx"
                            Command="{Binding ExportCommand}"
                            Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </controls:PageHeader.Actions>
        </controls:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="{StaticResource Pad.Card}"
                Margin="{StaticResource Gap.Below.MD}">
            <WrapPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Report" Margin="0,0,0,4" />
                    <ComboBox Width="230" ItemsSource="{Binding ReportTypes}"
                              SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Title" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Period" Margin="0,0,0,4" />
                    <ComboBox Width="150" ItemsSource="{Binding RangePresets}"
                              SelectedItem="{Binding SelectedRange}" />
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Search" Margin="0,0,0,4" />
                    <TextBox Width="260" Style="{StaticResource Input.Search}"
                             Tag="Product, user or printer…"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search report" />
                </StackPanel>
                <Button VerticalAlignment="Bottom" Margin="0,0,0,4" Height="36"
                        Style="{StaticResource Button.Secondary}" Content="Run report"
                        Command="{Binding RunCommand}" />
            </WrapPanel>
        </Border>

        <!-- Totals across the WHOLE filtered set, not just the loaded page -->
        <Grid Grid.Row="2" Margin="{StaticResource Gap.Below.MD}"
              Visibility="{Binding Totals, Converter={StaticResource NullToCollapsed}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Jobs" />
                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="20" FontWeight="SemiBold"
                               Text="{Binding Totals.Jobs, StringFormat=N0}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Labels" />
                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Brand.Primary}"
                               Text="{Binding Totals.Labels, StringFormat=N0}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Cartons" />
                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="20" FontWeight="SemiBold"
                               Text="{Binding Totals.Cartons, StringFormat=N0}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Padding="12,10">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource Card}">
                        <Setter Property="Background" Value="{StaticResource Brush.Danger.Soft}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Totals.Failed, FallbackValue=0}" Value="0">
                                <Setter Property="Background" Value="{StaticResource Surface.Card}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Failed" />
                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent.Danger}"
                               Text="{Binding Totals.Failed, StringFormat=N0}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="8" Style="{StaticResource Card}" Padding="12,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Reprints" />
                    <TextBlock Style="{StaticResource Text.Mono}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource Accent.Info}"
                               Text="{Binding Totals.Reprints, StringFormat=N0}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Text.H2}" Margin="16,12,16,0"
                           Text="{Binding Title}" />

                <Grid Grid.Row="1">
                    <!-- Detail rows -->
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              Visibility="{Binding IsDetailReport, Converter={StaticResource BoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job" Binding="{Binding JobNo}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="When"
                                                Binding="{Binding RequestedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="130" />
                            <DataGridTextColumn Header="Product" Binding="{Binding Key}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Secondary}" Width="*" MinWidth="140" />
                            <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="100" />
                            <DataGridTextColumn Header="User" Binding="{Binding User}" Width="110" />
                            <DataGridTextColumn Header="Printer" Binding="{Binding Printer}" Width="130" />
                            <DataGridTextColumn Header="Labels" Binding="{Binding Labels, StringFormat=N0}" Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:StatusPill Status="{Binding Status}" VerticalAlignment="Center"
                                                             HorizontalAlignment="Left" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Aggregated rows -->
                    <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                              Visibility="{Binding IsDetailReport, Converter={StaticResource InverseBoolToVisibility}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Key}" Width="220" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Secondary}" Width="*" MinWidth="160" />
                            <DataGridTextColumn Header="Jobs" Binding="{Binding Jobs, StringFormat=N0}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Labels" Binding="{Binding Labels, StringFormat=N0}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Cartons" Binding="{Binding Cartons, StringFormat=N0}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Failed" Binding="{Binding Failed, StringFormat=N0}" Width="90">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Reprints" Binding="{Binding Reprints, StringFormat=N0}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Last printed"
                                                Binding="{Binding LastPrintedUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:EmptyState Glyph="&#xE9D9;" Title="No printing activity"
                                         Message="Nothing was printed in this period. Try a wider period or a different search."
                                         Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <controls:ErrorState Message="{Binding ErrorMessage}" Reference="{Binding ErrorReference}"
                                         RetryCommand="{Binding RunCommand}"
                                         Visibility="{Binding ErrorMessage, Converter={StaticResource NullToCollapsed}}" />
                </Grid>

                <ProgressBar Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource State.BusyBar}" />
            </Grid>
        </Border>

        <controls:LoadMoreFooter Grid.Row="4" HasMore="{Binding HasMore}" IsLoading="{Binding IsBusy}"
                                 Command="{Binding LoadMoreCommand}" CountText="{Binding CountText}" />
    </Grid>
</UserControl>
