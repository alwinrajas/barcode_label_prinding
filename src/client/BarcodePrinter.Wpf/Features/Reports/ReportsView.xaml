<UserControl x:Class="BarcodePrinter.Wpf.Features.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.H1}"
                       Text="{Binding Title}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
                    Content="⤓  Export to Excel" Command="{Binding ExportCommand}"
                    Visibility="{Binding CanExport, Converter={StaticResource BoolToVisibility}}" />
            <!-- Report.Print is its own permission: exporting data and putting it
                 on paper are separately grantable (A-24 / §13). -->
            <Button DockPanel.Dock="Right" Height="36" Padding="14,0" Margin="0,0,8,0"
                    Content="🖶  Print" Command="{Binding PrintReportCommand}"
                    Visibility="{Binding CanPrint, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>

        <Border Grid.Row="1" Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Report" Margin="0,0,0,4" />
                    <ComboBox Width="230" Height="36" ItemsSource="{Binding ReportTypes}"
                              SelectedItem="{Binding SelectedReport}" DisplayMemberPath="Title" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Period" Margin="0,0,0,4" />
                    <ComboBox Width="150" Height="36" ItemsSource="{Binding RangePresets}"
                              SelectedItem="{Binding SelectedRange}" />
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Search" Margin="0,0,0,4" />
                    <TextBox Width="240" Style="{StaticResource Input.Text}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Search report" />
                </StackPanel>
                <Button VerticalAlignment="Bottom" Margin="0,0,0,4" Height="36" Padding="16,0"
                        Content="Run report" Command="{Binding RunCommand}" />
            </StackPanel>
        </Border>

        <!-- Totals across the WHOLE filtered set, not just the loaded page -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                Visibility="{Binding Totals, Converter={StaticResource NullToCollapsed}}">
            <UniformGrid Columns="5">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Jobs" />
                    <TextBlock Style="{StaticResource Text.H1}"
                               Text="{Binding Totals.Jobs, StringFormat=N0}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Labels" />
                    <TextBlock Style="{StaticResource Text.H1}" Foreground="{StaticResource Brand.Primary}"
                               Text="{Binding Totals.Labels, StringFormat=N0}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Cartons" />
                    <TextBlock Style="{StaticResource Text.H1}"
                               Text="{Binding Totals.Cartons, StringFormat=N0}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Failed" />
                    <TextBlock Style="{StaticResource Text.H1}" Foreground="{StaticResource Accent.Danger}"
                               Text="{Binding Totals.Failed, StringFormat=N0}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="Reprints" />
                    <TextBlock Style="{StaticResource Text.H1}" Foreground="{StaticResource Accent.Info}"
                               Text="{Binding Totals.Reprints, StringFormat=N0}" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <!-- Detail rows -->
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                          Background="Transparent" RowHeight="38" EnableRowVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13"
                          Visibility="{Binding IsDetailReport, Converter={StaticResource BoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Job" Binding="{Binding JobNo}" Width="180">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="When"
                                            Binding="{Binding RequestedAtUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="140" />
                        <DataGridTextColumn Header="Product" Binding="{Binding Key}" Width="150" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Secondary}" Width="*" MinWidth="140" />
                        <DataGridTextColumn Header="Batch" Binding="{Binding Batch}" Width="110" />
                        <DataGridTextColumn Header="User" Binding="{Binding User}" Width="110" />
                        <DataGridTextColumn Header="Printer" Binding="{Binding Printer}" Width="140" />
                        <DataGridTextColumn Header="Labels" Binding="{Binding Labels}" Width="80" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Aggregated rows -->
                <DataGrid ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0"
                          Background="Transparent" RowHeight="38" EnableRowVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          FontFamily="{StaticResource Font.Ui}" FontSize="13"
                          Visibility="{Binding IsDetailReport, Converter={StaticResource InverseBoolToVisibility}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Key}" Width="220" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Secondary}" Width="*" MinWidth="160" />
                        <DataGridTextColumn Header="Jobs" Binding="{Binding Jobs, StringFormat=N0}" Width="90" />
                        <DataGridTextColumn Header="Labels" Binding="{Binding Labels, StringFormat=N0}" Width="110" />
                        <DataGridTextColumn Header="Cartons" Binding="{Binding Cartons, StringFormat=N0}" Width="100" />
                        <DataGridTextColumn Header="Failed" Binding="{Binding Failed, StringFormat=N0}" Width="90" />
                        <DataGridTextColumn Header="Reprints" Binding="{Binding Reprints, StringFormat=N0}" Width="100" />
                        <DataGridTextColumn Header="Last printed"
                                            Binding="{Binding LastPrintedUtc, StringFormat=dd/MM/yyyy HH:mm}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}"
                           Foreground="{StaticResource Text.Secondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
                <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True" BorderThickness="0"
                             Background="Transparent" Foreground="{StaticResource Brand.Primary}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Accent.Danger}"
                       Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{StaticResource Accent.Success}"
                       Text="{Binding StatusMessage}"
                       Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
            <Button HorizontalAlignment="Center" Style="{StaticResource Button.Primary}" Content="Load more"
                    Command="{Binding LoadMoreCommand}"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </Grid>
</UserControl>
