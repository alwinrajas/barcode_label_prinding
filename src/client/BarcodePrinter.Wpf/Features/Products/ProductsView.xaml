<UserControl x:Class="BarcodePrinter.Wpf.Features.Products.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Surface.Base}">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ═══ Left: search + grid ═══ -->
        <Grid Grid.Column="0" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.H1}" Text="Products"
                           VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
                        Content="＋ New product" Command="{Binding NewProductCommand}"
                        Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
            </DockPanel>

            <TextBox Grid.Row="1" Margin="0,12,0,12" Style="{StaticResource Input.Text}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search products"
                     Tag="Search by code or description…" />

            <Border Grid.Row="2" Background="{StaticResource Surface.Card}"
                    BorderBrush="{StaticResource Border.Default}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              GridLinesVisibility="None" BorderThickness="0"
                              Background="Transparent" RowHeight="44"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              LoadingRow="OnLoadingRow"
                              FontFamily="{StaticResource Font.Ui}" FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="56">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="36" Height="36" CornerRadius="4"
                                                Background="{StaticResource Surface.Sunken}">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <!-- Monospace: 0/O and 1/l/I must be distinguishable (§12) -->
                                        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="UOM" Binding="{Binding Uom}" Width="70" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" />
                            <DataGridTextColumn Header="Color" Binding="{Binding Color}" Width="100" />
                            <DataGridTextColumn Header="Batch" Binding="{Binding DefaultBatch}" Width="110" />
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Status: colour + text, never colour alone (§12) -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource Accent.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Fill" Value="{StaticResource Text.Secondary}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Active" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Inactive" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty / error state -->
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Text.Body}"
                               Foreground="{StaticResource Text.Secondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

                    <ProgressBar Height="3" VerticalAlignment="Top" IsIndeterminate="True"
                                 BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource Brand.Primary}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>

            <Button Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Center"
                    Content="Load more" Command="{Binding LoadMoreCommand}"
                    Style="{StaticResource Button.Primary}"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <!-- ═══ Right: detail drawer ═══ -->
        <Border Grid.Column="1" Width="400" Style="{StaticResource Card}" Padding="20"
                Visibility="{Binding Editor, Converter={StaticResource NullToCollapsed}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding}" >
                    <TextBlock Style="{StaticResource Text.H1}" Text="{Binding Editor.Title}" />

                    <!-- Image -->
                    <Border Margin="0,16,0,0" Height="140" CornerRadius="6"
                            Background="{StaticResource Surface.Sunken}">
                        <Grid>
                            <Image Source="{Binding EditorImage}" Stretch="Uniform" Margin="8" />
                            <TextBlock Text="No image" Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding EditorImage, Converter={StaticResource NullToVisible}}" />
                        </Grid>
                    </Border>
                    <Button Margin="0,8,0,0" Content="Upload image…" HorizontalAlignment="Left"
                            Command="{Binding UploadImageCommand}"
                            Style="{StaticResource Button.Primary}" Height="32"
                            Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Fields -->
                    <TextBlock Style="{StaticResource Text.Label}" Text="Product code *" Margin="0,16,0,4" />
                    <TextBox Style="{StaticResource Input.Text}" FontFamily="{StaticResource Font.Mono}"
                             Text="{Binding Editor.Code, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Text.Label}" Text="Description *" Margin="0,12,0,4" />
                    <TextBox Style="{StaticResource Input.Text}"
                             Text="{Binding Editor.Description, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="UOM" Margin="0,0,0,4" />
                            <ComboBox Height="36" ItemsSource="{Binding Uoms}"
                                      SelectedValue="{Binding Editor.UomId}"
                                      SelectedValuePath="Id" DisplayMemberPath="Code" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Size" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Text}"
                                     Text="{Binding Editor.Size, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Color" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Text}"
                                     Text="{Binding Editor.Color, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Default batch" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Text}"
                                     Text="{Binding Editor.DefaultBatch, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Production date" Margin="0,0,0,4" />
                            <DatePicker Height="36" SelectedDate="{Binding Editor.DefaultProductionDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Expiry date" Margin="0,0,0,4" />
                            <DatePicker Height="36" SelectedDate="{Binding Editor.DefaultExpiryDate}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Quantity text (e.g. 750[D])" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Text}"
                                     Text="{Binding Editor.DefaultQuantityText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Carton quantity" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource Input.Text}"
                                     Text="{Binding Editor.CartonQuantityText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- Messages -->
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Accent.Danger}" TextWrapping="Wrap"
                               Text="{Binding Editor.ErrorMessage}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                               Foreground="{StaticResource Accent.Success}"
                               Text="{Binding Editor.SavedMessage}" />

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="Save"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding Editor.IsBusy, Converter={StaticResource InverseBool}}"
                                Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                        <Button Margin="12,0,0,0" Height="40" Padding="16,0"
                                Content="{Binding Editor.ActiveActionLabel}"
                                Command="{Binding ToggleActiveCommand}"
                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
