<Window x:Class="BarcodePrinter.Wpf.Shell.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BarcodePrinter.Wpf.Controls"
        Title="Barcode Label Printing"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{StaticResource Surface.Base}">

    <!-- Blueprint §12 / §12.1 shell: 3 rows —
         header 56 · (sidebar | content) · status bar 28. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Header ═══ -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Icon}"
                        Width="36" Height="36" Margin="10,0,0,0" VerticalAlignment="Center"
                        Command="{Binding ToggleSidebarCommand}"
                        AutomationProperties.Name="Toggle navigation">
                    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <Image DockPanel.Dock="Left" Source="/Assets/logo-mark.png" Height="28"
                       Margin="10,0,0,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Text.H1}" FontSize="17"
                           Text="Barcode Label Printing" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <!-- Connection: colour + word, never colour alone (§12) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Accent.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerOnline}" Value="False">
                                            <Setter Property="Fill" Value="{StaticResource Accent.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource Font.Ui}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Connected" />
                                    <Setter Property="Foreground" Value="{StaticResource Text.Secondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerOnline}" Value="False">
                                            <Setter Property="Text" Value="Disconnected" />
                                            <Setter Property="Foreground" Value="{StaticResource Accent.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Border Background="{StaticResource Surface.Sunken}" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource Text.Secondary}" />
                            <TextBlock Style="{StaticResource Text.Body}" FontSize="13"
                                       VerticalAlignment="Center">
                                <Run Text="{Binding UserDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding RoleDisplay, Mode=OneWay, StringFormat=({0})}"
                                     Foreground="{StaticResource Text.Secondary}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Row 1: Sidebar + Content ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Sidebar.Background}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NavList" ItemsSource="{Binding NavItems}" Margin="0,8"
                                      KeyboardNavigation.DirectionalNavigation="Contained">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource Nav.Item}" GroupName="nav"
                                                 Checked="OnNavItemChecked" Tag="{Binding}"
                                                 ToolTip="{Binding Title}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock x:Name="NavTitle" Text="{Binding Title}" Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding DataContext.SidebarTextVisibility,
                                                           RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Collapse toggle pinned to the sidebar foot -->
                    <Button Grid.Row="1" Height="36" Margin="8" HorizontalContentAlignment="Left"
                            Command="{Binding ToggleSidebarCommand}" Cursor="Hand"
                            AutomationProperties.Name="Collapse navigation"
                            ToolTip="Collapse navigation">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Sidebar.TextMuted}" />
                                <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FocusVisualStyle">
                                    <Setter.Value>
                                        <Style>
                                            <Setter Property="Control.Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <Rectangle Margin="-2" RadiusX="7" RadiusY="7"
                                                                   Stroke="White" StrokeThickness="1.5"
                                                                   Opacity="0.8" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background"
                                                            Value="{StaticResource Sidebar.Hover}" />
                                                    <Setter Property="Foreground"
                                                            Value="{StaticResource Sidebar.Text}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE76B;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                                <Setter Property="Text" Value="&#xE76C;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Collapse" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding SidebarTextVisibility}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Content host: real pages where a phase has landed, an
                 explanatory placeholder otherwise -->
            <Grid Grid.Column="1">
                <ContentControl x:Name="PageHost" Focusable="False" />
                <Border x:Name="Placeholder" Padding="32">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="{Binding SelectedItem.Glyph}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Style="{StaticResource Text.Display}" Margin="0,16,0,8"
                                   HorizontalAlignment="Center"
                                   Text="{Binding SelectedItem.Title}" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Text="{Binding SelectedItem.PageHint}" />
                    </StackPanel>
                </Border>
                <controls:ToastHost />
            </Grid>
        </Grid>

        <!-- ═══ Row 2: System status bar (system status ONLY — §12.1) ═══ -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Sunken}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Accent.Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerOnline}" Value="False">
                                        <Setter Property="Fill" Value="Transparent" />
                                        <Setter Property="Stroke" Value="{StaticResource Accent.Danger}" />
                                        <Setter Property="StrokeThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                               VerticalAlignment="Center" Text="{Binding ServerStatusText}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Text="{Binding VersionDisplay}" />
                <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Text="{Binding UserDisplay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
