<Window x:Class="BarcodePrinter.Wpf.Shell.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Barcode Label Printing"
        Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface.Base}">

    <!-- Blueprint §12 / §12.1 shell: 3 rows —
         header 56 · (sidebar | content) · status bar 28. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══ Row 0: Header ═══ -->
        <Border Grid.Row="0" Background="{StaticResource Surface.Card}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Left" Width="44" Height="44" Margin="8,0,0,0"
                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Command="{Binding ToggleSidebarCommand}"
                        AutomationProperties.Name="Toggle navigation">
                    <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource Text.Primary}" />
                </Button>
                <TextBlock DockPanel.Dock="Left" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Text.H1}" Text="Barcode Label Printing" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource Surface.Sunken}" CornerRadius="12" Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{StaticResource Text.Secondary}" />
                            <TextBlock Style="{StaticResource Text.Body}" VerticalAlignment="Center">
                                <Run Text="{Binding UserDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding RoleDisplay, Mode=OneWay, StringFormat=({0})}"
                                     Foreground="{StaticResource Text.Secondary}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══ Row 1: Sidebar + Content ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Sidebar.Background}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="NavList" ItemsSource="{Binding NavItems}" Margin="0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource Nav.Item}" GroupName="nav"
                                             Checked="OnNavItemChecked" Tag="{Binding}"
                                             ToolTip="{Binding Title}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="16" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavTitle" Text="{Binding Title}" Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding DataContext.SidebarTextVisibility,
                                                       RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Content host: real pages where a phase has landed, an
                 explanatory placeholder otherwise -->
            <Grid Grid.Column="1">
                <ContentControl x:Name="PageHost" Focusable="False" />
                <Border x:Name="Placeholder" Padding="32">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="{Binding SelectedItem.Glyph}" FontFamily="Segoe MDL2 Assets"
                                   FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}" />
                        <TextBlock Style="{StaticResource Text.Display}" Margin="0,16,0,8"
                                   HorizontalAlignment="Center"
                                   Text="{Binding SelectedItem.Title}" />
                        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{StaticResource Text.Secondary}"
                                   Text="{Binding SelectedItem.PageHint}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══ Row 2: System status bar (system status ONLY — §12.1) ═══ -->
        <Border Grid.Row="2" Background="{StaticResource Surface.Sunken}"
                BorderBrush="{StaticResource Border.Default}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource Accent.Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsServerOnline}" Value="False">
                                        <Setter Property="Fill" Value="{StaticResource Accent.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="6,0,0,0"
                               VerticalAlignment="Center" Text="{Binding ServerStatusText}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="16,0,0,0"
                               VerticalAlignment="Center" Text="{Binding VersionDisplay}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Text="{Binding UserDisplay}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
