<UserControl x:Class="BarcodePrinter.Wpf.Controls.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="self" IsHitTestVisible="{Binding IsActive, ElementName=self}"
             Visibility="{Binding IsActive, ElementName=self, Converter={StaticResource BoolToVisibility}}">
    <!-- Place as the LAST child of a Grid so it covers the content beneath. -->
    <Border Background="#B3FFFFFF">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                       HorizontalAlignment="Center"
                       Text="{Binding Text, ElementName=self}"
                       Visibility="{Binding Text, ElementName=self, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
    </Border>
</UserControl>
