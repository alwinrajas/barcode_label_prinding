<UserControl x:Class="BarcodePrinter.Wpf.Controls.LoadMoreFooter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="self">
    <StackPanel HorizontalAlignment="Center" Margin="0,8">
        <Button Style="{StaticResource Button.Ghost}" Content="Load more"
                HorizontalAlignment="Center"
                Command="{Binding Command, ElementName=self}"
                Visibility="{Binding HasMore, ElementName=self, Converter={StaticResource BoolToVisibility}}"
                IsEnabled="{Binding IsLoading, ElementName=self, Converter={StaticResource InverseBool}}" />
        <ProgressBar Width="120" Margin="0,6,0,0" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, ElementName=self, Converter={StaticResource BoolToVisibility}}" />
        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   Text="{Binding CountText, ElementName=self}"
                   Visibility="{Binding CountText, ElementName=self, Converter={StaticResource NullToCollapsed}}" />
    </StackPanel>
</UserControl>
