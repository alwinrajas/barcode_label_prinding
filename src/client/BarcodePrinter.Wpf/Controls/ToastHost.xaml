<UserControl x:Class="BarcodePrinter.Wpf.Controls.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:BarcodePrinter.Wpf.Services"
             IsHitTestVisible="True" Focusable="False"
             HorizontalAlignment="Right" VerticalAlignment="Bottom">
    <!-- Overlay bottom-right of the content area; newest toast at the bottom. -->
    <ItemsControl x:Name="Items" Margin="0,0,16,16"
                  AutomationProperties.LiveSetting="Polite">
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type svc:Toast}">
                <Border x:Name="card" Width="360" Margin="0,8,0,0" CornerRadius="8"
                        Background="{StaticResource Text.Primary}" Opacity="0"
                        SnapsToDevicePixels="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="slide" Y="12" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" Color="#12161C" />
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     To="1" Duration="0:0:0.18" />
                                    <DoubleAnimation Storyboard.TargetName="slide"
                                                     Storyboard.TargetProperty="Y"
                                                     To="0" Duration="0:0:0.18">
                                        <DoubleAnimation.EasingFunction>
                                            <QuadraticEase EasingMode="EaseOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="bar" Width="3" CornerRadius="1.5" Margin="0,10"
                                Background="{StaticResource Accent.Info}" />
                        <TextBlock x:Name="glyph" Grid.Column="1" Text="&#xE946;"
                                   FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="12,14,0,0"
                                   Foreground="{StaticResource Accent.Info}" />
                        <StackPanel Grid.Column="2" Margin="10,12,4,12">
                            <TextBlock Text="{Binding Message}" Foreground="White" TextWrapping="Wrap"
                                       FontFamily="{StaticResource Font.Ui}" FontSize="13" />
                            <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource Font.Mono}"
                                       FontSize="11" Foreground="#9AA5B1"
                                       Text="{Binding Reference, StringFormat=Reference: {0}}"
                                       Visibility="{Binding Reference, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>
                        <Button Grid.Column="3" Width="24" Height="24" Margin="0,8,8,0"
                                VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Click="OnCloseClicked"
                                AutomationProperties.Name="Dismiss notification">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="#9AA5B1" />
                        </Button>
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Success">
                        <Setter TargetName="bar" Property="Background" Value="{StaticResource Accent.Success}" />
                        <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent.Success}" />
                        <Setter TargetName="glyph" Property="Text" Value="&#xE930;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Error">
                        <Setter TargetName="bar" Property="Background" Value="{StaticResource Accent.Danger}" />
                        <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent.Danger}" />
                        <Setter TargetName="glyph" Property="Text" Value="&#xEA39;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Warning">
                        <Setter TargetName="bar" Property="Background" Value="{StaticResource Accent.Warning}" />
                        <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent.Warning}" />
                        <Setter TargetName="glyph" Property="Text" Value="&#xE7BA;" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
