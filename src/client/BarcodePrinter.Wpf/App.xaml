<Application x:Class="BarcodePrinter.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BarcodePrinter.Wpf"
             ShutdownMode="OnExplicitShutdown">
    <!-- ShutdownMode is managed in code: explicit while we swap login → shell,
         then OnMainWindowClose once the shell is up. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="DesignSystem/Tokens.xaml" />
                <ResourceDictionary Source="DesignSystem/Colors.xaml" />
                <ResourceDictionary Source="DesignSystem/Controls.xaml" />
                <ResourceDictionary Source="DesignSystem/ScreenStates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <local:NullToVisibleConverter x:Key="NullToVisible" />
            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:JoinListConverter x:Key="JoinList" />
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <local:CountToVisibilityConverter x:Key="CountToVisibility" />
            <local:ZeroToVisibilityConverter x:Key="ZeroToVisibility" />
            <local:FractionOfHeightConverter x:Key="FractionOfHeight" />
            <local:PluralConverter x:Key="Plural" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
