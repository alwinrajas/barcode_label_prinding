{
  "ConnectionStrings": {
    "BarcodePrinter": "Server=127.0.0.1;Port=33061;Database=barcodeprinter;Uid=root;Pwd=devroot;AllowLoadLocalInfile=true;MinimumPoolSize=5;MaximumPoolSize=60"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  },
  "Jwt": {
    "Issuer": "BarcodePrinter",
    "Audience": "BarcodePrinter",
    "SigningKey": "dev-only-signing-key-not-for-production-0123456789abcdef",
    "AccessTokenMinutes": 15
  },
  "MinimumClientVersion": "1.0.0"
}